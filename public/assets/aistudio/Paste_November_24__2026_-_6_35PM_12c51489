function updateConfigurator() {
  const camKey = document.getElementById('cfg-camera').value;
  const lensKey = document.getElementById('cfg-lens').value;
  const dist = parseFloat(document.getElementById('cfg-distance').value);

  document.getElementById('cfg-distance-val').textContent = dist.toFixed(1) + ' m';

  const cam = cfgCameraSpecs[camKey];
  const lens = cfgLensSpecs[lensKey];

  const hfovRad = 2 * Math.atan(cam.w / (2 * lens.f));
  const vfovRad = 2 * Math.atan(cam.h / (2 * lens.f));
  const hfovDeg = (hfovRad * 180) / Math.PI;
  const vfovDeg = (vfovRad * 180) / Math.PI;

  const targetW = 2 * dist * Math.tan(hfovRad / 2);
  const targetH = 2 * dist * Math.tan(vfovRad / 2);

  document.getElementById('res-sensor').textContent = `${cam.sensor} (${cam.w}×${cam.h}mm)`;
  document.getElementById('res-fov').textContent = `${hfovDeg.toFixed(2)}° × ${vfovDeg.toFixed(2)}° (f=${lens.f}mm)`;
  document.getElementById('res-area').textContent = `${targetW.toFixed(2)} m × ${targetH.toFixed(2)} m (@${dist.toFixed(1)}m)`;
  document.getElementById('res-usb').textContent = cam.usb;

  const diags = [];
  if (cam.usb2) {
    diags.push({ type: 'warn', text: 'USB 2.0 인터페이스 한계: 1920×1200 비압축 전송 시 약 6~8fps로 제한되며, 고속 촬영 시 손실 압축(MJPEG)만 가능합니다.' });
  } else {
    diags.push({ type: 'ok', text: 'USB 3.0 이상 고속 전송 지원: 비압축(UYVY/YUY2/RAW8) 고속 스트리밍이 가능합니다.' });
  }

  if (lens.unknownF) {
    diags.push({ type: 'warn', text: '조리개(F값) 사양 미기재: 공식 스펙상 F2.8 이상 여부를 확인할 수 없어 정밀 광학 설계 시 주의가 필요합니다.' });
  } else {
    diags.push({ type: 'ok', text: `조리개 사양(${lens.aperture}) 충족: F2.8 이상 조건을 만족하며 1/2.3" 이하 센서에서 비네팅 없이 동작합니다.` });
  }

  if (lens.bulky && cam.isCase) {
    diags.push({ type: 'danger', text: '기구물 간섭 경고: Edmund Optics #33-878(외경 22mm, 길이 38mm)은 완제품 케이스 개구부와 간섭할 수 있으므로 보드형 바디를 선택하세요.' });
  } else if (cam.isCase && camKey !== 'elp_l12') {
    diags.push({ type: 'info', text: '케이스 모델 유의: 기본 장착된 광각 렌즈를 탈거해야 하며, 12mm 렌즈 돌출 길이와 홀더 높이(10~13mm) 간섭 여부를 확인하세요.' });
  }

  if (lens.hasIrCut === 'no') {
    diags.push({ type: 'warn', text: 'IR-Cut 필터 미포함 렌즈: 주간 컬러 촬영 시 적외선 유입으로 색감이 왜곡될 수 있습니다(야간 IR 조명용 적합).' });
  } else if (lens.hasIrCut === 'yes') {
    diags.push({ type: 'ok', text: '650nm IR-Cut 필터 내장: 주간 컬러 촬영 시 정확한 색 재현이 가능합니다.' });
  } else if (lens.hasIrCut === 'ir_corr') {
    diags.push({ type: 'ok', text: 'IR 보정 광학계: 가시광선과 근적외선(850~940nm) 대역의 초점 이동이 보정된 렌즈입니다.' });
  } else {
    diags.push({ type: 'info', text: 'IR-Cut 필터 여부 미기재: 기존 기본 렌즈에서 필터가 분리되므로 주간 컬러 촬영 시 필터 유무를 판매처에 확인하세요.' });
  }

  if (cam.ndaa) {
    diags.push({ type: 'ok', text: 'NDAA 제889조 준수 및 하드웨어 GPIO 트리거 연동 지원 모델입니다.' });
  }

  const badgeStyles = {
    ok: 'bg-teal-50 border-teal-200 text-teal-900',
    warn: 'bg-amber-50 border-amber-200 text-amber-900',
    danger: 'bg-rose-50 border-rose-200 text-rose-900',
    info: 'bg-blue-50 border-blue-200 text-blue-900'
  };
  const icons = { ok: '✅', warn: '⚠️', danger: '🚨', info: 'ℹ️' };

  document.getElementById('cfg-diagnostics').innerHTML = diags.map(d => `
    <div class="p-2.5 rounded-lg border ${badgeStyles[d.type]} flex items-start gap-2">
      <span>${icons[d.type]}</span>
      <span>${d.text}</span>
    </div>
  `).join('');

  drawFovCanvas(hfovRad, dist, targetW, cam.name, lens.name);
}

function drawFovCanvas(hfovRad, dist, targetW, camName, lensName) {
  const canvas = document.getElementById('fov-canvas');
  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  canvas.width = rect.width * dpr;
  canvas.height = rect.height * dpr;
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);

  const w = rect.width;
  const h = rect.height;
  ctx.clearRect(0, 0, w, h);

  // Grid lines
  ctx.strokeStyle = '#1C1917';
  ctx.lineWidth = 1;
  for (let x = 40; x < w; x += 40) {
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
  }

  const startX = 48;
  const centerY = h / 2;
  const maxDrawDist = w - 110;
  const drawDist = Math.max(60, (dist / 30) * maxDrawDist);
  const endX = startX + drawDist;

  // Scale vertical half-span proportionally to tan(hfov/2) * drawDist
  const halfSpan = Math.min(h * 0.4, Math.tan(hfovRad / 2) * drawDist * 1.45);

  // Cone fill
  const grad = ctx.createLinearGradient(startX, centerY, endX, centerY);
  grad.addColorStop(0, 'rgba(29, 78, 216, 0.45)');
  grad.addColorStop(1, 'rgba(13, 148, 136, 0.18)');
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.moveTo(startX, centerY);
  ctx.lineTo(endX, centerY - halfSpan);
  ctx.lineTo(endX, centerY + halfSpan);
  ctx.closePath();
  ctx.fill();

  // Cone borders
  ctx.strokeStyle = '#38BDF8';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(startX, centerY);
  ctx.lineTo(endX, centerY - halfSpan);
  ctx.moveTo(startX, centerY);
  ctx.lineTo(endX, centerY + halfSpan);
  ctx.stroke();

  // Target width plane line
  ctx.strokeStyle = '#2DD4BF';
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.moveTo(endX, centerY - halfSpan);
  ctx.lineTo(endX, centerY + halfSpan);
  ctx.stroke();

  // Camera body marker
  ctx.fillStyle = '#F8FAFC';
  ctx.fillRect(startX - 18, centerY - 10, 18, 20);
  ctx.fillStyle = '#3B82F6';
  ctx.fillRect(startX, centerY - 6, 6, 12);

  // Labels
  ctx.fillStyle = '#E7E5E4';
  ctx.font = '600 11px Pretendard, sans-serif';
  ctx.fillText(`거리: ${dist.toFixed(1)}m`, startX + drawDist / 2 - 22, centerY - 6);

  ctx.fillStyle = '#2DD4BF';
  ctx.font = '700 12px Pretendard, sans-serif';
  ctx.fillText(`촬영 폭 ${targetW.toFixed(2)}m`, endX + 8, centerY + 4);

  ctx.fillStyle = '#A8A29E';
  ctx.font = '11px Pretendard, sans-serif';
  ctx.fillText(`${camName} + ${lensName}`, 12, h - 10);
}

function applyPreset(type) {
  const camSel = document.getElementById('cfg-camera');
  const lensSel = document.getElementById('cfg-lens');
  if (type === 'arducam') {
    camSel.value = 'arducam_b0495';
    lensSel.value = 'arducam_m1812';
  } else if (type === 'industrial') {
    camSel.value = 'basler_160';
    lensSel.value = 'commonlands_cil125_irc';
  } else if (type === 'elp') {
    camSel.value = 'elp_l12';
    lensSel.value = 'elp_stock';
  }
  updateConfigurator();
  document.getElementById('sec-configurator').scrollIntoView({ behavior: 'smooth' });
}

