      b.className = 'cam-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-stone-100 text-stone-700 hover:bg-stone-200';
    });
    this.className = 'cam-filter-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-stone-900 text-white';
    renderCameraTable(this.dataset.filter);
  });
});

document.querySelectorAll('.lens-filter-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.lens-filter-btn').forEach(b => {
      b.className = 'lens-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-stone-100 text-stone-700 hover:bg-stone-200';
    });
    this.className = 'lens-filter-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-stone-900 text-white';
    renderLensTable(this.dataset.filter);
  });
});

document.querySelectorAll('.check-card').forEach(card => {
  card.addEventListener('click', function() {
    const isChecked = this.dataset.checked === 'true';
    this.dataset.checked = (!isChecked).toString();
    const box = this.querySelector('.check-box');
    if (!isChecked) {
      this.classList.add('border-teal-600', 'bg-teal-50/40');
      this.classList.remove('border-stone-200', 'bg-stone-50/60');
      box.classList.add('bg-teal-600', 'border-teal-600');
      box.classList.remove('border-stone-400');
    } else {
      this.classList.remove('border-teal-600', 'bg-teal-50/40');
      this.classList.add('border-stone-200', 'bg-stone-50/60');
      box.classList.remove('bg-teal-600', 'border-teal-600');
      box.classList.add('border-stone-400');
    }
    const total = document.querySelectorAll('.check-card').length;
    const done = document.querySelectorAll('.check-card[data-checked="true"]').length;
    document.getElementById('checklist-progress').textContent = `${done} / ${total} 완료`;
  });
});

document.querySelectorAll('.nav-pill').forEach(pill => {
  pill.addEventListener('click', function() {
    document.querySelectorAll('.nav-pill').forEach(p => p.classList.remove('active'));
    this.classList.add('active');
    const target = document.getElementById(this.dataset.target);
    if (target) target.scrollIntoView({ behavior: 'smooth' });
  });
});

document.getElementById('cfg-camera').addEventListener('change', updateConfigurator);
document.getElementById('cfg-lens').addEventListener('change', updateConfigurator);
document.getElementById('cfg-distance').addEventListener('input', updateConfigurator);
window.addEventListener('resize', updateConfigurator);

renderCameraTable('all');
renderLensTable('all');
initCharts();
updateConfigurator();
</script>
